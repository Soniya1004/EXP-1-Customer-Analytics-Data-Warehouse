-- =========================================================
-- 4. SAMPLE ANALYTICAL QUERY (Star Schema)
-- =========================================================

SELECT
    g.geography,
    ge.gender,
    COUNT(*) AS total_customers,
    SUM(CASE WHEN f.exited = 1 THEN 1 ELSE 0 END) AS churned_customers,
    ROUND(
        100.0 * SUM(CASE WHEN f.exited = 1 THEN 1 ELSE 0 END)
        / NULLIF(COUNT(*), 0), 2
    ) AS churn_percentage
FROM customer_analytics_star.fact_customer_churn f
JOIN customer_analytics_star.dim_customer c
    ON f.customer_key = c.customer_key
JOIN customer_analytics_star.dim_geography g
    ON f.geography_key = g.geography_key
JOIN customer_analytics_star.dim_gender ge
    ON f.gender_key = ge.gender_key
GROUP BY g.geography, ge.gender
ORDER BY churn_percentage DESC;

