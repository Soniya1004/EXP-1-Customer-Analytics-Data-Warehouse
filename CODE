    geography_key  INTEGER PRIMARY KEY,
    geography      VARCHAR(100) NOT NULL
);

CREATE TABLE IF NOT EXISTS customer_analytics_snowflake.dim_gender (
    gender_key     INTEGER PRIMARY KEY,
    gender         VARCHAR(30) NOT NULL
);

CREATE TABLE IF NOT EXISTS customer_analytics_snowflake.dim_customer (
    customer_key   INTEGER PRIMARY KEY,
    customer_id    BIGINT NOT NULL UNIQUE,
    surname        VARCHAR(100),
    geography_key  INTEGER NOT NULL,
    gender_key     INTEGER NOT NULL,
    CONSTRAINT fk_snow_customer_geography
        FOREIGN KEY (geography_key)
        REFERENCES customer_analytics_snowflake.dim_geography(geography_key),
    CONSTRAINT fk_snow_customer_gender
        FOREIGN KEY (gender_key)
        REFERENCES customer_analytics_snowflake.dim_gender(gender_key)
);

CREATE TABLE IF NOT EXISTS customer_analytics_snowflake.fact_customer_churn (
    churn_fact_id      BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    customer_key       INTEGER NOT NULL,
    geography_key      INTEGER NOT NULL,
    gender_key         INTEGER NOT NULL,
    credit_score       INTEGER,
    age                INTEGER,
    tenure             INTEGER,
    balance            NUMERIC(14,2),
    num_of_products    INTEGER,
    has_cr_card        BOOLEAN,
    is_active_member   BOOLEAN,
    estimated_salary   NUMERIC(14,2),
    exited             SMALLINT NOT NULL CHECK (exited IN (0, 1)),
    CONSTRAINT fk_snow_fact_customer
        FOREIGN KEY (customer_key)
        REFERENCES customer_analytics_snowflake.dim_customer(customer_key),
    CONSTRAINT fk_snow_fact_geography
        FOREIGN KEY (geography_key)
        REFERENCES customer_analytics_snowflake.dim_geography(geography_key),
    CONSTRAINT fk_snow_fact_gender
        FOREIGN KEY (gender_key)
        REFERENCES customer_analytics_snowflake.dim_gender(gender_key)
);

